{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the main window: the window's own permissions, Emby's commands, and opening the player (build.rs)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-emby-servers",
    "allow-emby-add",
    "allow-emby-edit",
    "allow-emby-remove",
    "allow-emby-status",
    "allow-emby-libraries",
    "allow-emby-items",
    "allow-emby-sources",
    "allow-emby-episodes",
    "allow-emby-versions",
    "allow-player-open"
  ]
}
