{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hoshizora",
  "identifier": "io.github.cole4eva123.hoshizora",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev --port 1420 --strictPort",
    "beforeBuildCommand": "bun run build --outDir dist-app"
  },
  "app": {
    "windows": [
      {
        "title": "放映室",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "backgroundColor": "#020a20"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.themoviedb.org https://api.mdblist.com",
        "img-src": "'self' data: https: http: symbol:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
