{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hoshizora",
  "identifier": "io.github.cole4eva123.hoshizora",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev --port 1420 --strictPort",
    "beforeBuildCommand": "bunx tsc -b && bunx vite build --outDir dist-app"
  },
  "app": {
    "windows": [
      {
        "title": "HOSHIZORA",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "backgroundColor": "#020a20"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
